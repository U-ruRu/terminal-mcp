        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Attach this connector once using session_number. Use action='attach' with session_number and optional initial intent. Repeated attach preserves existing intent and its timer. Before any domain write, set intent here with action='intent', intent=...; refresh uses the existing binding and never needs session_number. Refresh intent every 180 seconds. The first due call warns; the next write is blocked until refresh. Reads, cancel, recovery, release and message ACK/reply remain available under their existing policy. Access only issues the number. The local binding survives restart and automatic work-cycle rearm. Manage issuance and end the shared access cycle through Access MCP. Contract updated for Terminal MCP 0.14.1.",
      "inputSchema": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "required": [
                "session_number"
              ]
            },
            "if": {
              "properties": {
                "action": {
                  "const": "intent"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "session_number"
                ]
              },
              "required": [
                "intent"
              ]
            }
          }
        ],
        "properties": {
          "action": {
            "default": "attach",
            "enum": [
              "attach",
              "intent"
            ],
            "type": "string"
          },
          "intent": {
            "description": "Required for intent refresh; optional on attach.",
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "session_number": {
            "description": "Required only for attach; forbidden for intent refresh.",
            "maxLength": 4,
            "minLength": 4,
            "pattern": "^[0-9]{4}$",
            "type": "string"
          }
        },
        "type": "object",
        "x-terminal-mcp-action-matrix": {
          "attach": {
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false,
            "readOnlyHint": false,
            "x-openai-isConsequential": true
