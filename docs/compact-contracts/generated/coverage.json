  "coordinator.message": {
    "action_models": {},
    "baseline_description_preserved": true,
    "conditions": [
      "ALL_OF(IF ANY_OF({text_offset:int} | {text_limit:int}) => {action?:\"read\"; message_hash:string} | IF {action:\"read\"; message_hash:string} => {text?:null; target?:null; cursor?:null; namespace?:null; task_id?:null; mode?:null; require_reply?:false; alert?:false} | IF action==\"send\" => requires(text) | IF action==\"ack\" => requires(message_hash) | IF action==\"reply\" => requires(message_hash,text))"
    ],
    "exact_input_fallbacks": [
      "$/properties/scope"
    ],
