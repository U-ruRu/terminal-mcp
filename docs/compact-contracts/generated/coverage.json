    "model": "terminal_mcp.mcp.role_contracts.MessageInput",
    "output_fallback": "strict-contracts.json:coordinator.message.outputSchema",
    "public_validation_boundary": "object-only / all named & unknown argument values forwarded",
    "published_input_sha256": "a2c799262a3ce3c19ef5cdd983bf3d12b43ab3c426227091b909dcb7054738c0",
    "published_output_sha256": "a2c799262a3ce3c19ef5cdd983bf3d12b43ab3c426227091b909dcb7054738c0",
    "required_fields": [
      "action"
    ],
    "runtime_annotations": [
      {
        "anchor": "def validate_mode(self):",
        "source": "src/terminal_mcp/mcp/role_contracts.py",
        "text": "send requires non-null text; message_hash must be absent or null. ack requires non-null message_hash; text must be absent or null. reply requires both text and message_hash non-null. read/history/recipients require both text and message_hash absent or null; explicit null is accepted (non-null values forbidden)."
      },
      {
        "anchor": "this server only. Message recipients require a current local attachment; ",
        "source": "src/terminal_mcp/mcp/roles.py",
        "text": "Messages use local attachments and expire after 24 hours; scope is always local."
      },
      {
        "anchor": "normalized_mode = mode or (\"alert\" if alert or require_reply else \"notify\")",
        "source": "src/terminal_mcp/application/access_mesh_messages.py",
        "text": "For send/reply, nullable mode defaults to notify; mode=alert sets alert and require_reply. Either alert=true or require_reply=true forces final mode=alert even when mode=notify or mode=ack. mode=ack is a delivery mode, distinct from action=ack. Send mode defaults to notify. mode=notify marks read_at automatically on first recipient display, so acknowledged=true means read/handled and does not prove an explicit ACK. mode=ack requires action=ack to set read_at. mode=alert requires a reply to release its reply obligation; action=ack alone does not satisfy it. Either alert=true or require_reply=true promotes notify/ack to alert. first_seen_at records first display; read_at records notify auto-read or explicit ACK; replied_at records actual reply. Repeated ACK is idempotent and creates no new message."
      },
      {
        "anchor": "def _route_issue(",
        "source": "src/terminal_mcp/application/access_mesh_messages.py",
        "text": "Local send routes are exclusive: use target=<local public_name> with namespace/task_id absent, OR namespace + task_id together for the task’s current local owners, with target absent/null or broadcast. A partial task pair or a named target combined with a task pair fails input_validation_failed with path/reason/repair hint and outcome=not_committed (no message created). If neither route is specified, the send is a local broadcast (may fail no_active_recipients). reply uses the parent sender and ignores supplied target. For send, missing/null target means local broadcast when no task pair is given."
      }
    ],
    "strict_input_sha256": "98d1f14d1274161695f6f789efa15770ac734ebd89532d191e10e8b8f5fd9a05",
    "strict_output_sha256": "a5ef2a6390329c1f1bb737a23e1cdede9f689c61360e125f670a12097a24371c"
  },
