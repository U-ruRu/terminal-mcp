TERMINAL_MCP_HOST="127.0.0.1"
TERMINAL_MCP_PORT="8080"
TERMINAL_MCP_PUBLIC_BASE_URL="https://server-a.example.invalid"
TERMINAL_MCP_CONSOLE_ALLOWED_ORIGINS="https://localhost"
TERMINAL_MCP_ENV_FILE_PATH="/etc/terminal-mcp/terminal-mcp.env"
TERMINAL_MCP_DATABASE_PATH="/var/lib/terminal-mcp/terminal-mcp.sqlite3"
TERMINAL_MCP_SHELL="/bin/bash"
TERMINAL_MCP_CWD="/"
TERMINAL_MCP_TERMINAL_USER="root"
TERMINAL_MCP_AUTH_MODE="none"
TERMINAL_MCP_MCP_AUTH_MODE="oauth"
TERMINAL_MCP_ACTIONS_AUTH_MODE="bearer"
TERMINAL_MCP_BEARER_TOKENS=""
TERMINAL_MCP_BEARER_CREDENTIALS_JSON="[]"
TERMINAL_MCP_OAUTH_USERS_JSON="[]"
TERMINAL_MCP_ADMIN_USERNAME="operator"
TERMINAL_MCP_ADMIN_PASSWORD="replace-at-deploy"
TERMINAL_MCP_ADMIN_SESSION_SECRET="replace-with-random-secret"
TERMINAL_MCP_OAUTH_ISSUER="https://server-a.example.invalid"
TERMINAL_MCP_OAUTH_AUDIENCE="https://server-a.example.invalid/mcp"
TERMINAL_MCP_OAUTH_JWKS_URL=""
TERMINAL_MCP_OAUTH_SIGNING_SECRET="replace-with-random-secret"
TERMINAL_MCP_OAUTH_REQUIRED_SCOPES="terminal:read terminal:execute"
TERMINAL_MCP_OAUTH_ACCESS_TTL_SEC="2592000"
TERMINAL_MCP_OAUTH_REFRESH_TTL_SEC="2592000"
TERMINAL_MCP_OAUTH_CODE_TTL_SEC="300"
TERMINAL_MCP_AGENT_IDLE_TTL_SEC="300"
TERMINAL_MCP_AGENT_INTENT_TTL_SEC="180"
TERMINAL_MCP_AGENT_MAX_SESSION_SEC="1500"
TERMINAL_MCP_AGENT_SESSION_WARNING_AFTER_SEC="1200"
TERMINAL_MCP_AGENT_SESSION_ALERT_ENABLED="true"
TERMINAL_MCP_AGENT_SESSION_ALERT_AFTER_SEC="1380"
TERMINAL_MCP_AGENT_SESSION_ALERT_REPEAT_SEC="60"
TERMINAL_MCP_AGENT_SESSION_ALERT_MESSAGE="Ваша сессия закончилась. У пользователя для вас новая задача. Завершите сессию и немедленно вернитесь в чат к пользователю, чтобы дать ему промежуточный отчёт, получить дальнейшие указания и новую задачу."
TERMINAL_MCP_AGENT_EVENT_WINDOW_SEC="180"
TERMINAL_MCP_AGENT_COMMAND_PREVIEW_CHARS="160"
TERMINAL_MCP_AGENT_HISTORY_DEFAULT_MINUTES="60"
TERMINAL_MCP_MESSAGE_REMINDER_SEC="180"
TERMINAL_MCP_MESSAGE_REMINDER_CALLS="5"
TERMINAL_MCP_MAX_ACTIVE_AGENTS="8"
TERMINAL_MCP_QUEUE_WORKERS="4"
TERMINAL_MCP_QUEUE_RECONCILE_SEC="1.0"
TERMINAL_MCP_PERSISTENT_AGENTS_ENABLED="true"
TERMINAL_MCP_PERSISTENT_SESSION_DURATION_SEC="1380"
TERMINAL_MCP_PERSISTENT_SESSION_WARNING_AFTER_SEC="1200"
TERMINAL_MCP_PERSISTENT_SESSION_ALERT_AFTER_SEC="1320"
TERMINAL_MCP_PERSISTENT_SESSION_REARM_AFTER_SEC="180"
# Optional override; omit to derive Legacy admission from Persistent + MCP auth capability.
# TERMINAL_MCP_LEGACY_AGENT_ADMISSION_ENABLED="false"

# Optional runtime-only fleet federation. Keep real peer identities and keys out of Git.
TERMINAL_MCP_FLEET_INSTANCE_ID=""
TERMINAL_MCP_FLEET_SIGNING_PRIVATE_KEY=""
TERMINAL_MCP_FLEET_PEERS_JSON="[]"
TERMINAL_MCP_FLEET_REPLICATION_INTERVAL_SEC="5"
TERMINAL_MCP_FLEET_REQUEST_TIMEOUT_SEC="3"
# Keep peer authentication while allowing Fleet v1 to retire the old full-mesh sync loops.
TERMINAL_MCP_FLEET_LEGACY_REPLICATION_ENABLED="true"
TERMINAL_MCP_FLEET_V1_SOURCE_ENABLED="false"
TERMINAL_MCP_FLEET_ID=""
TERMINAL_MCP_FLEET_NODE_ID=""
TERMINAL_MCP_FLEET_NODE_META_PATH="/var/lib/terminal-mcp/fleet-node-meta.sqlite3"

TERMINAL_MCP_AUTH_DATABASE_PATH="./data/auth.sqlite3"

# Fleet v1 authority/control plane (default off)
TERMINAL_MCP_FLEET_V1_AUTHORITY_ENABLED=false
TERMINAL_MCP_FLEET_V1_PROJECTION_ENABLED=false
TERMINAL_MCP_FLEET_V1_PUBLIC_ENABLED=false
TERMINAL_MCP_FLEET_PROJECTION_OWNER_NODE_ID=""
TERMINAL_MCP_FLEET_PROJECTION_FOLLOWER_NODE_ID=""
TERMINAL_MCP_FLEET_PROJECTION_PATH="./data/fleet-projection.sqlite3"
TERMINAL_MCP_FLEET_CONTROL_NODE_ID=
TERMINAL_MCP_FLEET_CONTROL_PATH=
TERMINAL_MCP_FLEET_PERMIT_TTL_MS=10000
